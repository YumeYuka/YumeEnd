{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "aspen",
  "name": "梦璃",
  "description": "真正的成长并非抹杀过去的自己，而是在接纳伤痛后,依然有选择善良的勇气",
  "colors": {
    "primary": "#358e98",
    "light": "#fbf7f7",
    "dark": "#71c6db"
  },
  "icons": {
    "library": "lucide"
  },
  "favicon": {
    "light": "/logo/logo.png",
    "dark": "/logo/logo.png"
  },
  "navigation": {
    "languages": [
      {
        "language": "zh",
        "global": {
          "anchors": [
            {
              "anchor": "Github",
              "icon": "github",
              "href": "https://github.com/YumeYuka"
            },
            {
              "anchor": "加入群组",
              "icon": "telegram",
              "href": "https://join.oom-wg.dev"
            }
          ]
        },
        "dropdowns": [
          {
            "dropdown": "幻想乡",
            "icon": "fan",
            "groups": [
              {
                "group": "简介",
                "icon": "book-open",
                "pages": [
                  "index",
                  "friends"
                ]
              },
              {
                "group": "最新发布",
                "icon": "calendar",
                "pages": [
                  "blog/Amper",
                  "blog/edgeone-trap-diary",
                  "blog/apex-to-www"
                ]
              }
            ]
          }
        ]
      }
    ]
  },
  "logo": "/logo/logo.png",
  "seo": {
    "metatags": {
      "robots": "index, follow",
      "charset": "UTF-8",
      "viewport": "width=device-width, initial-scale=1.0",
      "googlebot": "index, follow",
      "generator": "Mintlify",
      "theme-color": "#f56c6c",
      "format-detection": "telephone=no",
      "referrer": "origin",
      "rating": "general",
      "revisit-after": "7 days",
      "language": "zh-CN",
      "copyright": "梦璃 YumeYuka",
      "distribution": "global",
      "HandheldFriendly": "True",
      "MobileOptimized": "320",
      "apple-mobile-web-app-capable": "yes",
      "apple-mobile-web-app-status-bar-style": "black",
      "apple-mobile-web-app-title": "梦璃",
      "application-name": "梦璃",
      "msapplication-TileColor": "#f56c6c",
      "og:type": "website",
      "og:image": "https://s3.yumeyuka.plus/2025/23-22-30.webp",
      "og:site_name": "真正的成长并非抹杀过去的自己，而是在接纳伤痛后,依然有选择善良的勇气",
      "og:locale": "zh_CN",
      "canonical": "https://yumeyuka.icu"
    },
    "indexing": "all"
  },
  "metadata": {
    "timestamp": true
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity"
    ]
  },
  "footer": {
    "socials": {
      "telegram": "https://t.me/OOM_Group",
      "github": "https://github.com/YumeYuka",
      "discord": "https://discord.gg/4HQ2DaqKX"
    }
  },
  "errors": {
    "404": {
      "redirect": true,
      "title": "找不到页面",
      "description": "这个_页面_到底**发生了什么**？"
    }
  },
  "styling": {
    "latex": true
  },
  "interaction": {
    "drilldown": true
  }
}
